---
import { Image } from 'astro:assets';
---

<!-- Wallet Download Modal -->
<div id="wallet-download-modal" class="fixed inset-0 z-[999] flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 ease-out-cubic">
  <button id="wallet-download-backdrop" class="absolute inset-0 bg-black/30 opacity-0 transition-opacity duration-200 ease-out-cubic" aria-label="Close modal"></button>
  <div
    role="dialog"
    aria-modal="true"
    aria-labelledby="wallet-download-title"
    class="relative mx-4 w-full max-w-md bg-white text-black p-5 shadow-xl ring-1 ring-black/10 transform origin-top scale-95 transition-transform duration-300 ease-out-cubic"
  >
    <div class="mb-4">
      <h2 id="wallet-download-title" class="text-lg font-semibold">Choose your wallet</h2>
      <p class="text-sm text-neutral-500">All options are supported equally. Pick the one you prefer.</p>
    </div>

    <div class="flex flex-col gap-2">
      <a href="https://beaconwallet.app" target="_blank" rel="noreferrer" class="w-full px-4 py-3 text-left text-sm font-medium ring-1 ring-neutral-200 hover:bg-neutral-100 transform transition duration-150 ease-out-cubic active:scale-[0.97]">
        <div class="flex items-center gap-3">
          <Image src="https://arweave.net/hESR2qOaFHSDa6bPuEQDNfU7ntqmAtffVRfqAOpSm7Y" width={28} height={28} alt="Beacon" />
          <div>
            <div>Beacon</div>
            <div class="text-[10px] font-normal opacity-70">Mobile wallet + connect via QR</div>
          </div>
        </div>
      </a>

      <a href="https://wander.app" target="_blank" rel="noreferrer" class="w-full px-4 py-3 text-left text-sm font-medium ring-1 ring-neutral-200 hover:bg-neutral-100 transform transition duration-150 ease-out-cubic active:scale-[0.97]">
        <div class="flex items-center gap-3">
          <Image src="https://arweave.net/GWqfysg_qT-0C7-9V0pFoiTEZ-R0nRkl_LjmKgef30U" width={28} height={28} alt="Wander" />
          <div>
            <div>Wander</div>
            <div class="text-[10px] font-normal opacity-70">Browser + Mobile Wallet</div>
          </div>
        </div>
      </a>

      <a href="https://arweave.app/connect" target="_blank" rel="noreferrer" class="w-full px-4 py-3 text-left text-sm font-medium ring-1 ring-neutral-200 hover:bg-neutral-100 transform transition duration-150 ease-out-cubic active:scale-[0.97]">
        <div class="flex items-center gap-3">
          <Image src="https://arweave.net/uzugTgdP9Wll7f3a6nIo-PFX0kCZ_5wpcKucxP45SXI" width={28} height={28} alt="Arweave.app" />
          <div>
            <div>Arweave.app</div>
            <div class="text-[10px] font-normal opacity-70">Web wallet</div>
          </div>
        </div>
      </a>
    </div>

    <div class="mt-4 flex justify-end">
      <button id="wallet-download-cancel" class="rounded-lg px-3 py-2 text-sm text-neutral-700 hover:bg-neutral-100">Close</button>
    </div>
  </div>
</div>



