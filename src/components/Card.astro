---
import Button from "./Button.astro";
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  href: string;
  ctaText: string;
  image?: string | null;
  imageAsset?: any | null; // optional optimized local asset
  showMedia?: boolean; // hide the media area for text-only cards
  mediaHeightClass?: string; // control media block height (e.g., 'h-56')
  mediaBG?: string; // control placeholder color
  itemsPosition?: string; 
  imageWidthClass?: string;
  className?: string; // optional wrapper classes (e.g., grid spans)
  ctaVariant?: 'minimal' | 'secondary' | 'primary';
  contentJustifyBetween?: boolean;
  // Optional bottom overlay and image for special cards
  showBottomOverlay?: boolean;
  bottomOverlayHeightClass?: string; 
  position?: string;
  relativeParent?: boolean; // make the top-level wrapper position: relative
  tag?: string; // optional top-right tag label
}

const {
  title,
  description,
  href,
  ctaText,
  image = null,
  imageAsset = null,
  showMedia = true,
  mediaHeightClass = 'h-56',
  mediaBG = 'bg-secondaryLight1',
  itemsPosition = '',
  className,
  imageWidthClass = 'max-w-[500px]',
  ctaVariant = 'minimal',
  contentJustifyBetween = false,
  bottomOverlayHeightClass = 'h-16',
  position = 'translate-y-0',
  relativeParent = false,
  tag

} = Astro.props as Props;
---
---

<article class:list={["group border border-gray-200 overflow-hidden h-full flex flex-col", (relativeParent || typeof tag === 'string') && 'relative', className]}>
  {typeof tag === 'string' && (
    <span class="absolute top-6 right-6 z-[1] inline-flex items-center px-2 py-0.5 border border-gray-300 bg-white text-xxs font-mono tracking-wide">
      {tag}
    </span>
  )}
  {showMedia && (
    <slot name="media">
      {imageAsset || image ? (
        <div class:list={[mediaHeightClass, mediaBG, itemsPosition, "relative overflow-hidden"]}>
          {imageAsset ? (
            <Image src={imageAsset} alt={title} class={`${imageWidthClass} ${position} w-full object-cover grayscale transition-[filter,transform,opacity] opacity-80 duration-300 group-hover:grayscale-0 group-hover:scale-[1.02] group-hover:opacity-100 ease-out-circ`} />
          ) : (
            <img src={image!} alt={title} class:list={[imageWidthClass, position,"w-full object-cover grayscale transition-[filter,transform,opacity] opacity-80 duration-300 group-hover:grayscale-0 group-hover:scale-[1.02] group-hover:opacity-100 ease-out-circ"]} />
          )}
          <div class:list={["pointer-events-none absolute inset-x-0 bottom-0 z-10", bottomOverlayHeightClass]}
          style="backdrop-filter: blur(1.5px); -webkit-backdrop-filter: blur(1.5px); background: linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,1) 100%);"></div>
        </div>

      ) : (
        <div class:list={[mediaHeightClass, mediaBG, "relative"]}>
           <div class:list={["pointer-events-none absolute inset-x-0 bottom-0 z-10", bottomOverlayHeightClass]}
      style="backdrop-filter: blur(1.5px); -webkit-backdrop-filter: blur(1.5px); background: linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,1) 100%);"></div>
        </div>
      )}

    </slot>
  )}
  <div class:list={["p-6 flex-1 flex flex-col", contentJustifyBetween && "justify-between"]}>
    <div>
      <h4 class="text-h4 font-sans lg:text-[24px]">{title}</h4>
      <p class="text-p3 font-sans mt-2">{description}</p>
    </div>
    <Button href={href} variant={ctaVariant} showArrow className="mt-8">{ctaText}</Button>
  </div>

  
</article>


