---
interface Props {
  href?: string;
  variant?: 'secondary' | 'primary' | 'minimal';
  showArrow?: boolean;
  className?: string;
  fullWidth?: boolean;
}

const {
  href,
  variant = 'primary',
  showArrow = false,
  className,
  fullWidth = false,
} = Astro.props as Props;

const base = 'inline-flex items-center justify-center font-mono text-p3 active:scale-[0.98] transition-transform transition-colors duration-150 ease-out';
const variants: Record<string, string> = {
  // New primary is the former secondary (outlined) with hover bg
  primary: 'border border-black text-black px-4 py-2 hover:bg-[#f7f7f7] bg-white',
  // Keep secondary as an alias for backward compatibility
  secondary: 'border border-black text-black px-4 py-2 hover:bg-[#f7f7f7] bg-white',
  minimal: 'font-mono underline text-current w-fit group',
};
const cls = [
  base,
  variants[variant],
  fullWidth ? 'w-full self-stretch' : 'w-fit',
  className,
].filter(Boolean).join(' ');
---

{href ? (
  <a href={href} class={cls}>
    <span class={variant === 'minimal' ? 'transition-opacity hover:opacity-70' : ''}>
      <slot />
    </span>
    {showArrow && <i class="ph ph-arrow-right ml-1 text-orange"></i>}
  </a>
) : (
  <button class={cls}>
    <span class={variant === 'minimal' ? 'transition-opacity hover:opacity-70' : ''}>
      <slot />
    </span>
    {showArrow && <i class="ph ph-arrow-right ml-1 text-orange"></i>}
  </button>
)}


