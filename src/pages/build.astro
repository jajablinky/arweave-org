---
import Layout from "../layouts/Layout.astro";
import { Image } from 'astro:assets';
import ScrollToTop from "../components/ScrollToTop.astro";
import FooterAlt from "../components/Footer-Alt.astro";
import Button from "../components/Button.astro";
import WalletDownloadModal from "../components/WalletDownloadModal.astro";
import Card from "../components/Card.astro";
import book from "../images/icons/permaweb-book.svg";
import aoLogo from "../images/logos/AO-logo-1.svg";
import hyperbeamLogo from "../images/logos/hyperbeam-logo-1.svg";
---

<Layout title="Build on Arweave">
  <!-- Temporary banner: under construction notice (Build page only)-->
  <div id="build-banner" class="fixed top-0 left-0 w-full bg-black text-white text-center py-2 font-sans text-sm transform transition-transform duration-500 ease-in-out-quint" role="status" aria-live="polite">
    Build page Under construction — upload functionality is limited.
  </div>
  <section class="relative z-10 min-h-[calc(100vh-200px)]" id="build" aria-label="Build on Arweave" class="pb-12">

      <!-- Kicker -->
      <div class="text-kicker lg:text-[16px] font-mono">Build Arweave.</div>

      <!-- Headline -->
      <h1 class="text-h1 lg:text-[48px] font-sans mt-2">Host your web app.</h1>

      <!-- Paragraph -->
      <p class="text-p1 lg:text-[14px] font-sans mt-3 max-w-4xl">
        Let's build on Arweave, which ensures your web app is permanently accessible online. This guarantees that your
        application remains available to users, eliminating the risk of being taken down or lost.
      </p>

      <!-- Content + Right sidebar layout -->
      <div class="mt-20 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_350px] gap-8 items-center">
        <!-- Main content: steps -->
        <div class="flex flex-col gap-10">
          <!-- Step 1 -->
          <section>
            <div class="group relative border border-gray-200 bg-white/60 p-5 transition-shadow duration-200 ease-out-cubic hover:shadow-sm">
              <div class="flex items-center gap-3">
                <div class="h-6 w-6 bg-black text-white flex items-center justify-center text-[11px] font-mono">1</div>
                <h3 class="text-h4 text-[24px]">Upload your code</h3>
              </div>
              <div class="mt-3 space-y-2">
                <div class="flex items-start gap-3"><span class="mt-2 h-1 w-1 bg-neutral-400"></span><p class="text-p3 font-sans">Drag and drop your code file to the right.</p></div>
                <div class="flex items-start gap-3"><span class="mt-2 h-1 w-1 bg-neutral-400"></span><p class="text-p3 font-sans">Files under 100 KB can be deployed for free.</p></div>
                <div class="flex items-start gap-3"><span class="mt-2 h-1 w-1 bg-neutral-400"></span><p class="text-p3 font-sans">If your file is larger, you’ll need to connect your wallet.</p></div>
                <div class="flex items-start gap-3"><span class="mt-2 h-1 w-1 bg-neutral-400"></span><p class="text-p3 font-sans">Don’t have a wallet? <button id="open-wallet-download" type="button" class="underline">Choose your wallet</button>.</p></div>
              </div>
            </div>
          </section>

          <!-- Step 2 -->
          <section>
            <div class="group relative border border-gray-200 bg-white/60 p-5 transition-shadow duration-200 ease-out-cubic hover:shadow-sm">
              <div class="flex items-center gap-3">
                <div class="h-6 w-6 bg-black text-white flex items-center justify-center text-[11px] font-mono">2</div>
                <h3 class="text-h4 text-[24px]">Confirm upload</h3>
              </div>
              <div class="mt-3 space-y-2">
                <div class="flex items-start gap-3"><span class="mt-2 h-1 w-1 bg-neutral-400"></span><p class="text-p3 font-sans">Once uploaded, your code will be queued for processing.</p></div>
              </div>
            </div>
          </section>

          <!-- Step 3 -->
          <section>
            <div class="group relative border border-gray-200 bg-white/60 p-5 transition-shadow duration-200 ease-out-cubic hover:shadow-sm">
              <div class="flex items-center gap-3">
                <div class="h-6 w-6 bg-black text-white flex items-center justify-center text-[11px] font-mono">3</div>
                <h3 class="text-h4 text-[24px]">Processing</h3>
              </div>
              <div class="mt-3 space-y-2">
                <div class="flex items-start gap-3"><span class="mt-2 h-1 w-1 bg-neutral-400"></span><p class="text-p3 font-sans">The system will handle deployment and prepare your app on the permaweb.</p></div>
              </div>
            </div>
          </section>

          <!-- Step 4 -->
          <section>
            <div class="group relative border border-gray-200 bg-white/60 p-5 transition-shadow duration-200 ease-out-cubic hover:shadow-sm">
              <div class="flex items-center gap-3">
                <div class="h-6 w-6 bg-black text-white flex items-center justify-center text-[11px] font-mono">4</div>
                <h3 class="text-h4 text-[24px]">Deployment complete</h3>
              </div>
              <div class="mt-3 space-y-2">
                <div class="flex items-start gap-3"><span class="mt-2 h-1 w-1 bg-neutral-400"></span><p class="text-p3 font-sans">After processing, your app will be permanently stored on Arweave.</p></div>
              </div>
            </div>
          </section>

          <!-- Step 5 -->
          <section>
            <div class="group relative border border-gray-200 bg-white/60 p-5 transition-shadow duration-200 ease-out-cubic hover:shadow-sm">
              <div class="flex items-center gap-3">
                <div class="h-6 w-6 bg-black text-white flex items-center justify-center text-[11px] font-mono">5</div>
                <h3 class="text-h4 text-[24px]">Access your app</h3>
              </div>
              <div class="mt-3 space-y-2">
                <div class="flex items-start gap-3"><span class="mt-2 h-1 w-1 bg-neutral-400"></span><p class="text-p3 font-sans">Your app is now live and permanently accessible on-chain via Arweave.</p></div>
              </div>
            </div>
          </section>
        </div>

        <!-- Right sidebar: dropzone mock (fixed ~350px) -->
        <aside class="w-full lg:w-[350px] max-w-full border border-gray-200 p-6 justify-self-end sticky top-6 self-start">
          <div class="grid grid-cols-2 items-end border-b border-gray-200">
            <div class="text-left font-mono text-[12px] tracking-[0.08em] py-2 border-b border-black">Host</div>
            <div class="text-left font-mono text-[12px] tracking-[0.08em] py-2 text-secondaryLight2">Visit</div>
          </div>
          <div class="mt-6 h-56 border-2 border-dashed border-gray-300 flex items-center justify-center text-center">
            <div>
              <div class="font-mono">Drag and Deploy</div>
              <div class="text-p3 text-secondaryLight2">Under &lt;100KB</div>
              <div class="text-p3 mt-2">or <span class="underline">choose file</span> to upload</div>
            </div>
          </div>
        </aside>
      </div>

  </section>
  <WalletDownloadModal />

  <!-- Data-focused developer section -->
  <section class="pt-24" aria-label="Develop with data">

    <!-- Kicker -->
    <div class="text-kicker lg:text-[16px] font-mono">Build Arweave.</div>

    <!-- Headline -->
      <h2 class="text-h1 lg:text-[56px] font-sans">Develop with a foundation of data.</h2>

      <!-- Cards grid: 4+1 layout on large screens -->
      <div class="mt-8 grid grid-cols-1 lg:grid-cols-3 gap-6">
        <script src="https://unpkg.com/@phosphor-icons/web@2.1.1"></script>
        <Card
          className="group lg:col-span-2 lg:row-span-2 min-h-[250px]"
          showMedia={true}
          mediaHeightClass="h-0"
          mediaBG="bg-transparent"
          relativeParent={true}
          tag="Docs"
          title="Get Started Developing."
          description="Your application remains accessible to everyone, forever, without the risk of censorship or removal. Visit the permaweb cookbook to start."
          href="https://cookbook.arweave.net"
          ctaText="Visit the Permaweb Cookbook"
          ctaVariant="secondary"
          contentJustifyBetween={true}
        >
          <div slot="media" class="absolute right-2 bottom-2 sm:right-4 sm:bottom-4 md:-right-4 md:-bottom-4 lg:-right-8 lg:-bottom-8">
            <!-- Absolute, behind content -->
            <div class="pointer-events-none inset-0 z-0">
              <!-- Icon constellation anchored bottom-right -->
              <div class="w-56 h-56 sm:w-64 sm:h-64 md:w-80 md:h-80 lg:w-96 lg:h-96">
                <style>
                  @keyframes orbit-slow { to { transform: rotate(360deg); } }
                  .orbit-rotate { animation: orbit-slow 90s linear infinite; transform-origin: center; }
                </style>
                <!-- Center book -->
                <Image src={book} alt="Permaweb Book" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-24 sm:h-28 md:h-36 lg:h-44 w-auto" />
                <!-- Circle icons (no backgrounds), rotating slowly while staying upright -->
                <div class="absolute inset-0 orbit-rotate">
                  <i class="ph ph-code-block absolute left-1/2 -translate-x-1/2 top-0 text-xl sm:text-2xl md:text-3xl transform scale-[0.9] opacity-80 transition-[transform,opacity] duration-100 ease-out-cubic group-hover:scale-100 group-hover:opacity-100" aria-hidden="true"></i>
                  <i class="ph ph-screwdriver absolute right-0 top-1/2 -translate-y-1/2 text-xl sm:text-2xl md:text-3xl transform scale-[0.9] opacity-80 transition-[transform,opacity] duration-100 ease-out-cubic delay-25 group-hover:scale-100 group-hover:opacity-100" aria-hidden="true"></i>
                  <i class="ph ph-cpu absolute left-1/2 -translate-x-1/2 bottom-0 text-xl sm:text-2xl md:text-3xl transform scale-[0.9] opacity-80 transition-[transform,opacity] duration-100 ease-out-cubic delay-50 group-hover:scale-100 group-hover:opacity-100" aria-hidden="true"></i>
                  <i class="ph ph-hammer absolute left-0 top-1/2 -translate-y-1/2 text-xl sm:text-2xl md:text-3xl transform scale-[0.9] opacity-80 transition-[transform,opacity] duration-100 ease-out-cubic delay-75 group-hover:scale-100 group-hover:opacity-100" aria-hidden="true"></i>
                  <i class="ph ph-polygon absolute left-[12%] top-[12%] text-xl sm:text-2xl md:text-3xl transform scale-[0.9] opacity-80 transition-[transform,opacity] duration-100 ease-out-cubic delay-100 group-hover:scale-100 group-hover:opacity-100" aria-hidden="true"></i>
                  <i class="ph ph-compass-tool absolute right-[12%] top-[12%] text-xl sm:text-2xl md:text-3xl transform scale-[0.9] opacity-80 transition-[transform,opacity] duration-100 ease-out-cubic delay-125 group-hover:scale-100 group-hover:opacity-100" aria-hidden="true"></i>
                  <i class="ph ph-blueprint absolute left-[12%] bottom-[12%] text-xl sm:text-2xl md:text-3xl transform scale-[0.9] opacity-80 transition-[transform,opacity] duration-100 ease-out-cubic delay-150 group-hover:scale-100 group-hover:opacity-100" aria-hidden="true"></i>
                  <i class="ph ph-wrench absolute right-[12%] bottom-[12%] text-xl sm:text-2xl md:text-3xl transform scale-[0.9] opacity-80 transition-[transform,opacity] duration-100 ease-out-cubic delay-175 group-hover:scale-100 group-hover:opacity-100" aria-hidden="true"></i>
                </div>
              </div>
            </div>
          </div>
        </Card>

        <Card
          className="lg:col-start-3 min-h-[250px]"
          showMedia={false}
          title="Dev Utility Tools."
          description="Build with ar.io’s comprehensive suite of developer utility tools."
          href="https://ar.io"
          ctaText="Use ar.io’s development suite"
          contentJustifyBetween={true}
        />

        <Card
          className="lg:col-start-3 min-h-[250px]"
          showMedia={false}
          title="View Arweave History."
          description="Blocks, accounts, transactions, protocols, and tokens."
          href="https://viewblock.io"
          ctaText="Visit Viewblock"
          contentJustifyBetween={true}
        />
      </div>

  </section>

  <!-- Decentralized Compute section -->
  <section class="relative mt-6 p-6 border border-gray-200 bg-[#FCFCFC]" aria-label="Decentralized Compute">
    <span class="absolute top-6 right-6 z-[1] inline-flex items-center rounded px-2 py-0.5 border border-gray-300 bg-white text-xxs font-mono tracking-wide">Computation with Data</span>

      <!-- Headline -->
      <h2 class="text-h3 font-sans ">Decentralized Compute.</h2>
      <p class="text-p1 lg:text-[14px] font-sans mt-2 max-w-xl ">
        The permaweb foundation backs projects like AO and Hyperbeam, improving smart contracts and Arweave’s infrastructure. Here’s how to begin.
      </p>

      <div class="mt-24 grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- AO Card -->
        <article class="relative border border-gray-200 p-6 flex bg-white flex-col justify-between min-h-[300px]">
          <span class="absolute top-6 right-6 z-[1] inline-flex items-center rounded px-2 py-0.5 border border-gray-300 bg-white text-xxs font-mono tracking-wide">Smart Contracts</span>
          <div>
            <Image src={aoLogo} alt="AO" class="h-5 w-auto mb-4" />
            <p class="text-p3 font-sans">
              Create and deploy processes (smart contracts) on Arweave.
            </p>
          </div>
          <div class="mt-6">
            <Button href="https://ao.arweave.net" variant="secondary" fullWidth showArrow>Explore AO Ecosystem</Button>
          </div>
        </article>

        <!-- Hyperbeam Card -->
        <article class="relative border border-gray-200 bg-white p-6 flex flex-col justify-between min-h-[300px]">
          <span class="absolute top-6 right-6 z-[1] inline-flex items-center rounded px-2 py-0.5 border border-gray-300 bg-white text-xxs font-mono tracking-wide">OS</span>
          <div>
            <Image src={hyperbeamLogo} alt="Hyperbeam" class="h-5 w-auto mb-4" />
            <p class="text-p3 font-sans">
Decentralized operating system on the permaweb.            </p>
          </div>
          <div class="mt-6">
            <Button href="https://hyperbeam.arweave.net" variant="secondary" fullWidth showArrow>Start Hyperbeam</Button>
          </div>
        </article>
      </div>

  </section>
  <FooterAlt />

  <ScrollToTop threshold={800} />

  <script>
    // @ts-nocheck
    document.addEventListener('DOMContentLoaded', () => {
      const buildBanner = document.getElementById('build-banner');
      const openBtn = document.getElementById('open-wallet-download');
      const modal = document.getElementById('wallet-download-modal');
      const backdrop = document.getElementById('wallet-download-backdrop');
      const cancel = document.getElementById('wallet-download-cancel');
      const panel = modal?.querySelector('[role="dialog"]');

      function open() {
        if (!modal) return;
        modal.classList.add('flex');
        modal.classList.remove('pointer-events-none');
        modal.style.opacity = '1';
        panel?.classList.remove('scale-95');
        panel?.classList.add('scale-100');
        backdrop?.classList.add('opacity-100');
      }
      function close() {
        if (!modal) return;
        panel?.classList.remove('scale-100');
        panel?.classList.add('scale-95');
        backdrop?.classList.remove('opacity-100');
        modal.style.opacity = '0';
        modal.classList.add('pointer-events-none');
        setTimeout(() => modal.classList.remove('flex'), 300);
      }
      openBtn?.addEventListener('click', open);
      backdrop?.addEventListener('click', close);
      cancel?.addEventListener('click', close);
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

      // Toggle the top banner based on scroll position
      if (buildBanner) {
        const updateBannerVisibility = () => {
          if (window.scrollY > 0) {
            buildBanner.classList.add('-translate-y-full');
          } else {
            buildBanner.classList.remove('-translate-y-full');
          }
        };
        updateBannerVisibility();
        window.addEventListener('scroll', updateBannerVisibility, { passive: true });
      }
    });
  </script>
</Layout>
