---
import FooterAlt from "../components/Footer-Alt.astro";
import Layout from "../layouts/Layout.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import Button from "../components/Button.astro";
import { Image } from 'astro:assets';
import onboardLogo from "../images/logos/onboard.png";
import communitylabsLogo from "../images/logos/communitylabs.svg";
import dhaLogo from "../images/logos/dha.png";
import forwardLogo from "../images/logos/forward.png";
import arioLogo from "../images/logos/ar-io-logo.svg";
import permadaoLogo from "../images/logos/permadao.png";
import longviewLogo from "../images/logos/longview.png";
import hansaLogo from "../images/logos/hansa.svg";
---

<Layout title="Arweave: Get Funded">
  <section id="fund" aria-label="Get Funded" class="relative z-10 pb-12">
    <style>
      /* Card banner hover color via CSS variable per card */
      #fund .group:hover .banner { background-color: var(--banner-hover, #F8F8F8); }
    </style>
    <!-- Kicker -->
    <div class="text-kicker lg:text-[16px] font-mono">Get Funded.</div>

    <!-- Headline -->
    <h1 class="text-h1 lg:text-[48px] font-sans mt-2">Funding the next generation of founders.</h1>

    <!-- Paragraph -->
    <p class="text-p1 lg:text-[14px] font-sans mt-3 max-w-4xl t">
      Arweave is a fully decentralized ecosystem. There are numerous dedicated organizations – ranging from non-profits,
      to DAOs and venture studios – that back its development and help the ecosystem grow. Many of these organizations have
      grant and investment opportunities available for those contributing to the Arweave ecosystem.
    </p>

    <!-- Top row: 3 orgs -->
     <div class="mt-20 grid grid-cols-1 lg:grid-cols-3 gap-2">
      <!-- Onboard -->
      <article class="group border border-gray-200 p-6 bg-white min-h-80 flex flex-col" style="--banner-hover:#DBE1E5;">
        <div class="banner -mx-6 -mt-6 px-6 py-4 bg-[#F8F8F8] border-b border-gray-200 flex items-center justify-center transition-colors duration-200 ease-out">
          <Image src={onboardLogo} alt="Onboard" class="h-8 object-contain transition-all opacity-70 group-hover:opacity-100 grayscale group-hover:grayscale-0" />
        </div>
        <div class="flex-1">
          <h3 class="mt-5 font-sans text-[20px] lg:text-[22px]">Onboard.</h3>
          <p class="mt-2 text-[14px] leading-[1.6] text-secondaryLight4">
            Store any quantity and type of data permanently and for a single payment.
          </p>
        </div>
        <Button href="https://onboard.arweave.net/" variant="secondary" showArrow={true} className="mt-4 text-xs">Fund Your Data Storage</Button>
      </article>

      <!-- Community Labs -->
      <article class="group border border-gray-200 p-6 bg-white min-h-80 flex flex-col" style="--banner-hover:#DFDBE5;">
        <div class="banner -mx-6 -mt-6 px-6 py-4 bg-[#F8F8F8] border-b border-gray-200 flex items-center justify-center transition-colors duration-200 ease-out">
          <Image src={communitylabsLogo} alt="Community Labs" class="h-8 object-contain transition-all opacity-70 group-hover:opacity-100 grayscale group-hover:grayscale-0" />
        </div>
        <div class="flex-1">
          <h3 class="mt-5 font-sans text-[20px] lg:text-[22px]">Community Labs.</h3>
          <p class="mt-2 text-[14px] leading-[1.6] text-secondaryLight4">
            Fueling the people and technologies redefining the decentralized future.
          </p>
        </div>
        <Button href="https://communitylabs.com" variant="secondary" showArrow={true} className="mt-4 text-xs">Fund Your Innovation</Button>
      </article>

      <!-- Digital History Association -->
      <article class="group border border-gray-200 p-6 bg-white min-h-80 flex flex-col" style="--banner-hover:#E5E3DB;">
        <div class="banner -mx-6 -mt-6 px-6 py-4 bg-[#F8F8F8] border-b border-gray-200 flex items-center justify-center transition-colors duration-200 ease-out">
          <Image src={dhaLogo} alt="Digital History Association" class="h-8 object-contain transition-all opacity-70 group-hover:opacity-100 grayscale group-hover:grayscale-0" />
        </div>
        <div class="flex-1">
          <h3 class="mt-5 font-sans text-[20px] lg:text-[22px]">Digital History Association.</h3>
          <p class="mt-2 text-[14px] leading-[1.6] text-secondaryLight4">
            Perform research on the core Arweave protocol and recommend improvements.
          </p>
        </div>
        <Button href="https://dha.arweave.net" variant="secondary" showArrow={true} className="mt-4 text-xs">Fund Your Protocol Research</Button>
      </article>
    </div>

    <!-- Middle row: 3 orgs -->
    <div class="mt-8 grid grid-cols-1 lg:grid-cols-3 gap-2">
      <!-- Forward Research -->
      <article class="group border border-gray-200 p-6 bg-white min-h-80 flex flex-col" style="--banner-hover:#EFE7DF;">
        <div class="banner -mx-6 -mt-6 px-6 py-4 bg-[#F8F8F8] border-b border-gray-200 flex items-center justify-center transition-colors duration-200 ease-out">
          <Image src={forwardLogo} alt="Forward Research" class="h-8 object-contain transition-all opacity-70 group-hover:opacity-100 grayscale group-hover:grayscale-0" />
        </div>
        <div class="flex-1">
          <h3 class="mt-5 font-sans text-[20px] lg:text-[22px]">Forward Research.</h3>
          <p class="mt-2 text-[14px] leading-[1.6] text-secondaryLight4">
            Invests in new ideas to drive progress over the long‑term in areas that matter most to free and open societies.
          </p>
        </div>
        <Button href="https://fwd.arweave.net" variant="secondary" showArrow={true} className="mt-4 text-xs">Fund Your Initiative</Button>
      </article>

      <!-- AR.IO -->
      <article class="group border border-gray-200 p-6 bg-white min-h-80 flex flex-col" style="--banner-hover:#F4E1E1;">
        <div class="banner -mx-6 -mt-6 px-6 py-4 bg-[#F8F8F8] border-b border-gray-200 flex items-center justify-center transition-colors duration-200 ease-out">
          <Image src={arioLogo} alt="AR.IO" class="h-6 object-contain transition-all opacity-70 group-hover:opacity-100 grayscale group-hover:grayscale-0" />
        </div>
        <div class="flex-1">
          <h3 class="mt-5 font-sans text-[20px] lg:text-[22px]">AR.IO.</h3>
          <p class="mt-2 text-[14px] leading-[1.6] text-secondaryLight4">
            Developed a grants program to help empower and incentivize the AR.IO community to contribute to the Network’s long‑term success.
          </p>
        </div>
        <Button href="https://ar.io" variant="secondary" showArrow={true} className="mt-4 text-xs">Fund Your Next Endeavor</Button>
      </article>

      <!-- Permadao -->
      <article class="group border border-gray-200 p-6 bg-white min-h-80 flex flex-col" style="--banner-hover:#DBE5E2;">
        <div class="banner -mx-6 -mt-6 px-6 py-4 bg-[#F8F8F8] border-b border-gray-200 flex items-center justify-center transition-colors duration-200 ease-out">
          <Image src={permadaoLogo} alt="Permadao" class="h-8 object-contain transition-all opacity-70 group-hover:opacity-100 grayscale group-hover:grayscale-0" />
        </div>
        <div class="flex-1">
          <h3 class="mt-5 font-sans text-[20px] lg:text-[22px]">Permadao.</h3>
          <p class="mt-2 text-[14px] leading-[1.6] text-secondaryLight4">
            A co‑builder community building the next generation of permaweb apps.
          </p>
        </div>
        <Button href="https://permadao.notion.site" variant="secondary" showArrow={true} className="mt-4 text-xs">Fund Your Work</Button>
      </article>
    </div>

    <!-- Bottom row: 2 orgs wider -->
    <div class="mt-8 grid grid-cols-1 lg:grid-cols-6 gap-2">
      <!-- Longview Labs -->
      <article class="group border border-gray-200 p-6 bg-white min-h-80 flex flex-col lg:col-span-2 lg:col-start-2" style="--banner-hover:#DBE5DC;">
        <div class="banner -mx-6 -mt-6 px-6 py-4 bg-[#F8F8F8] border-b border-gray-200 flex items-center justify-center transition-colors duration-200 ease-out">
          <Image src={longviewLogo} alt="Longview Labs" class="h-8 object-contain transition-all opacity-70 group-hover:opacity-100 grayscale group-hover:grayscale-0" />
        </div>
        <div class="flex-1">
          <h3 class="mt-5 font-sans text-[20px] lg:text-[22px]">Longview Labs.</h3>
          <p class="mt-2 text-[14px] leading-[1.6] text-secondaryLight4">
            Produce educational content, digital products, and community experiences.
          </p>
        </div>
        <Button href="https://longviewlabs.co" variant="secondary" showArrow={true} className="mt-4 text-xs">Fund Your Community Projects</Button>
      </article>

      <!-- Hansa -->
      <article class="group border border-gray-200 p-6 bg-white min-h-80 flex flex-col lg:col-span-2 lg:col-start-4" style="--banner-hover:#F2F2DF;">
        <div class="banner -mx-6 -mt-6 px-6 py-4 bg-[#F8F8F8] border-b border-gray-200 flex items-center justify-center transition-colors duration-200 ease-out">
          <Image src={hansaLogo} alt="Hansa" class="h-6 object-contain transition-all opacity-70 group-hover:opacity-100 grayscale group-hover:grayscale-0" />
        </div>
        <div class="flex-1">
          <h3 class="mt-5 font-sans text-[20px] lg:text-[22px]">Hansa.</h3>
          <p class="mt-2 text-[14px] leading-[1.6] text-secondaryLight4">
            Invests in new ideas to drive progress over the long‑term in areas that matter most to free and open societies.
          </p>
        </div>
        <Button href="https://www.hansa.capital/" variant="secondary" showArrow={true} className="mt-4 text-xs">Fund Your Initiative</Button>
      </article>
    </div>
  </section>
  <FooterAlt />
  <ScrollToTop threshold={800} />
</Layout>
