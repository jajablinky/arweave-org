---
import FooterAlt from "../components/Footer-Alt.astro";
import Tooltip from "../components/Tooltip.astro";
import Layout from "../layouts/Layout.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
---

<Layout title="Discover Arweave">
  <section id="discover" aria-label="Discover Arweave" class="relative z-10 pb-12">
    <!-- Kicker -->
    <div class="text-kicker lg:text-[16px] font-mono">Discover Arweave.</div>

    <!-- Headline -->
    <h1 class="text-h1 lg:text-[48px] font-sans mt-2">Find projects.</h1>

    <!-- Paragraph -->
    <p class="text-p1 lg:text-[14px] font-sans mt-3 max-w-4xl ">
      Apps & Infrastructure built on the foundation of permanent data. Can't see your project? <a href="https://github.com/nicolasverlhiac/arweave-list" target="_blank" rel="noopener" class="text-secondaryLight4 underline underline-offset-2 hover:no-underline">Add it here via pull request on Weavescan.</a>
    </p>

    <!-- Controls -->
    <div class="mt-10 sm:mt-20 sticky top-0 z-20 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/80 border-b border-gray-200">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-2 items-center p-2 lg:p-3">
        <div class="font-mono"><span class="text-orange font-bold" id="result-count">0</span> projects</div>
        <div class="lg:col-span-1">
          <div class="relative">
            <input id="search-input" type="text" placeholder="Search" class="w-full border border-gray-200 px-4 py-2.5 pr-10 h-8 outline-none focus:border-orange text-xs" />
            <i class="ph ph-magnifying-glass absolute right-3 top-1/2 -translate-y-1/2 text-secondaryLight2"></i>
          </div>
        </div>
        <div class="lg:col-span-1 lg:justify-self-end w-full">
          <!-- Accessible custom dropdown with a native fallback (visually hidden) -->
          <div class="relative" id="category-dropdown">
            <button id="cat-btn" class="w-full text-left border border-gray-200 px-4 h-8 text-xs outline-none focus:border-orange focus:ring-2 focus:ring-orange/30 rounded-sm aria-expanded:false" aria-haspopup="listbox" aria-expanded="false" aria-controls="cat-menu" aria-label="Select a category">
              All Categories
            </button>
            <div id="cat-menu" role="listbox" tabindex="-1" aria-labelledby="cat-btn" class="absolute left-0 right-0 mt-1 bg-white border border-gray-200 rounded-sm shadow-sm overflow-auto transition-all duration-200 ease-out opacity-0 max-h-0 pointer-events-none z-50">
              <!-- options injected dynamically -->
            </div>
          </div>
          <select id="category-select" class="sr-only" aria-hidden="true">
            <option value="all">All Categories</option>
          </select>
        </div>
        <style>
          /* Thin black scrollbar for category dropdown */
          #cat-menu{ scrollbar-width:thin; scrollbar-color:#000 transparent; }
          /* Force scrollbar to be visible on WebKit by reserving space */
          #cat-menu{ padding-right:2px; }
          #cat-menu::-webkit-scrollbar{ width:4px; }
          #cat-menu::-webkit-scrollbar-track{ background:transparent; }
          #cat-menu::-webkit-scrollbar-thumb{ background:#000; border-radius:9999px; }
          #cat-menu::-webkit-scrollbar-thumb:hover{ background:#111; }
        </style>
      </div>
    </div>

    <!-- Loading status -->
    <div id="loading" class="mt-4 flex items-center gap-2 px-6 text-xs text-secondaryLight4 hidden">
      <span id="loading-dots" aria-hidden="true">…</span>
      <span>Fetching projects</span>
    </div>

    <!-- Results grid -->
    <div id="results-grid" class="mt-2 grid grid-cols-1 lg:grid-cols-3 gap-2 p-6 bg-[#F8F8F8]"></div>
    <Tooltip selector=".desc" attr="data-fulldesc" delay={1000} fadeMs={100} />
    <Tooltip selector=".project-link" text="Visit website" delay={800} fadeMs={100} />

    

    <script>
      // @ts-nocheck
      document.addEventListener('DOMContentLoaded', async () => {
        const searchEl = document.getElementById('search-input');
        const selectEl = document.getElementById('category-select');
        const catBtn = document.getElementById('cat-btn');
        const catMenu = document.getElementById('cat-menu');
        const gridEl = document.getElementById('results-grid');
        const footerEl = document.getElementById('discover-footer');
        const countEl = document.getElementById('result-count');
        

        const API = 'https://api.weavescan.com/api/content/items/projects?populate=1';
        const IMG = (path) => `https://api.weavescan.com/storage/uploads${path}`;
        const CACHE_KEY = 'discover_projects_v1';
        const CACHE_TTL_MS = 1000 * 60 * 10; // 10 minutes

        let projects = [];
        let hasRenderedInitial = false; // prevents reshuffle after API returns
        let allCategories = new Set();
        const loadingEl = document.getElementById('loading');
        const loadingDots = document.getElementById('loading-dots');

        function collectCategoriesFromProjects(list) {
          const set = new Set();
          (list || []).forEach(p => {
            (p.categories || []).forEach(c => {
              if (typeof c === 'string' && c) set.add(c);
              else if (c && (c.name || c.id || c._id)) set.add(c.name || c.id || c._id);
            });
          });
          allCategories = set;
        }
        // Skeleton ghost loading while cache/API warm up
        function renderSkeleton(count = 9) {
          // show loading status with animated dots
          loadingEl.classList.remove('hidden');
          let dotCycle = 0;
          if (!loadingEl._dotTimer) {
            loadingEl._dotTimer = setInterval(() => {
              dotCycle = (dotCycle + 1) % 4;
              loadingDots.textContent = '.'.repeat(dotCycle) || '…';
            }, 400);
          }
          countEl.textContent = '—';
          gridEl.innerHTML = Array.from({ length: count }).map(() => `
            <article class="border border-gray-200 p-6 bg-white min-h-80 animate-pulse">
              <div class="flex items-start justify-between">
                <div class="h-12 w-12 bg-secondaryLight1 border border-gray-200"></div>
                <div class="h-4 w-20 bg-secondaryLight1"></div>
              </div>
              <div class="mt-5 h-5 w-2/3 bg-secondaryLight1"></div>
              <div class="mt-3 space-y-2">
                <div class="h-3 w-full bg-secondaryLight1"></div>
                <div class="h-3 w-5/6 bg-secondaryLight1"></div>
                <div class="h-3 w-4/6 bg-secondaryLight1"></div>
              </div>
              <div class="mt-4 flex gap-2">
                <div class="h-5 w-14 bg-secondaryLight1"></div>
                <div class="h-5 w-10 bg-secondaryLight1"></div>
              </div>
            </article>
          `).join('');
        }

        renderSkeleton();


        function shuffle(arr) {
          const a = arr.slice();
          for (let i = a.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [a[i], a[j]] = [a[j], a[i]];
          }
          return a;
        }

        // Merge freshly fetched projects into the existing list while preserving
        // the current ordering by id; new items are appended at the end
        function mergePreserveOrder(oldList, newList) {
          const byId = new Map(newList.map(p => [p.id, p]));
          const seen = new Set();
          const merged = [];
          // keep existing order using updated objects when available
          oldList.forEach(p => {
            const updated = byId.get(p.id);
            if (updated) {
              merged.push(updated);
              seen.add(p.id);
            }
          });
          // append any new items not present previously
          newList.forEach(p => { if (!seen.has(p.id)) merged.push(p); });
          return merged;
        }

        async function fetchProjects() {
          try {
            const res = await fetch(API);
            if (!res.ok) throw new Error('Network error');
            const data = await res.json();
            // API returns an array of items directly
            const raw = (Array.isArray(data) ? data : data?.items || [])
            const newProjects = raw.map((p) => ({
              id: p._id || p.id,
              title: p.title || '',
              desc: p.description || '',
              image: p.image?.path ? IMG(p.image.path) : null,
              link: p.link || '#',
              // categories may be array of refs or populated with name/id
              categories: (p.categories || []).map((c) => c?.id || c?._id || c?.name || '').filter(Boolean),
              tags: Array.isArray(p.tags) ? p.tags : [],
            }));
            // collect categories
            raw.forEach((p) => (p.categories || []).forEach((c) => {
              const name = c?.name || c?.id || c?._id || '';
              if (name) allCategories.add(name);
            }));
            // If we've already rendered (from cache), preserve that order
            // while updating content; otherwise shuffle once for variety
            projects = hasRenderedInitial ? mergePreserveOrder(projects, newProjects) : shuffle(newProjects);
            // write to cache with timestamp
            const payload = { ts: Date.now(), projects };
            try { localStorage.setItem(CACHE_KEY, JSON.stringify(payload)); } catch {}
          } catch (e) {
            console.error('Failed to load projects', e);
            projects = [];
          }
        }

        function render(list) {
          countEl.textContent = String(list.length);
          // Empty state when no projects match filters/search
          if (!list.length) {
            gridEl.innerHTML = `
            <div class="col-span-1 lg:col-span-3 p-6 text-center text-[14px] text-secondaryLight4">
              <p>No matching projects.</p>
              <p class="mt-2">Can't see your project? <a href="https://github.com/nicolasverlhiac/arweave-list" target="_blank" rel="noopener" class="text-orange underline underline-offset-2 hover:no-underline">Add it here via pull request on Weavescan.</a>.</p>
            </div>`;
            if (footerEl) footerEl.classList.add('hidden');
            return;
          }
          gridEl.innerHTML = list.map(p => `
            <article class="group border border-gray-200 p-6 bg-white min-h-80">
              <div class="flex items-start justify-between">
                ${p.image 
                  ? `<a href="${p.link || '#'}" target="_blank" rel="noopener" class="project-link"><img src="${p.image}" alt="${p.title}" class="h-12 w-12 object-cover border border-gray-200 transition-all opacity-70 group-hover:opacity-100 hover:opacity-100 grayscale group-hover:grayscale-0 hover:grayscale-0 active:grayscale-0"/></a>`
                  : `<a href="${p.link || '#'}" target="_blank" rel="noopener" class="project-link"><div class=\"h-12 w-12 border border-gray-300 flex items-center justify-center text-secondaryLight4 text-[18px] font-medium transition-opacity hover:opacity-80\">${(p.title||'?').charAt(0)}</div></a>`}
                ${p.categories && p.categories.length ? `<span class=\"text-xxs px-2 py-[3px] bg-secondaryLight1 text-secondaryLight4\">${p.categories[0]}</span>` : ''}
              </div>
              <h3 class="mt-5 font-sans text-[20px] lg:text-[22px]"><a href="${p.link || '#'}" target="_blank" rel="noopener" class="project-link underline-offset-2 hover:underline">${p.title}</a></h3>
              <p class="desc mt-2 text-[14px] leading-[1.6] text-secondaryLight4" data-fulldesc="${p.desc.replace(/"/g,'&quot;')}" style="display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;">${p.desc}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                ${p.tags.map(t => `<span class=\"text-xxs px-2 py-[3px] bg-secondaryLight1 text-secondaryLight4\">${t}</span>`).join('')}
              </div>
            </article>
          `).join('');
          // Reveal footer when we have content
          if (list && list.length && footerEl) footerEl.classList.remove('hidden');
          // no card-level click; only title and image anchors navigate
          // populate category dropdown (only when we have categories)
          const cats = Array.from(allCategories).sort((a,b)=>a.localeCompare(b));
          if (cats.length > 0 && !selectEl.dataset.populated) {
            // native fallback
            while (selectEl.options.length > 1) selectEl.remove(1);
            cats.forEach(c => {
              const opt = document.createElement('option');
              opt.value = c;
              opt.textContent = c;
              selectEl.appendChild(opt);
            });
            // custom dropdown menu
            const makeItem = (label, value, selected) => `
              <div role="option" aria-selected="${selected ? 'true' : 'false'}" data-value="${value}" class="px-4 py-2 text-xs hover:bg-gray-50 focus:bg-gray-50 cursor-pointer">
                ${label}
              </div>`;
            let html = makeItem('All Categories', 'all', true);
            html += cats.map(c => makeItem(c, c, false)).join('');
            catMenu.innerHTML = html;
            selectEl.dataset.populated = '1';
          }
        }

        function applyFilters() {
          const q = (searchEl.value || '').toLowerCase();
          const cat = selectEl.value || 'all';
          let filtered = projects.filter(p => {
            const matchesText = p.title.toLowerCase().includes(q) || p.desc.toLowerCase().includes(q);
            const matchesCat = cat === 'all' || p.categories.includes(cat) || p.tags.includes(cat);
            return matchesText && matchesCat;
          });
          // sort by title ASC for stable order when a category is selected
          filtered = filtered.sort((a,b)=>a.title.localeCompare(b.title));
          render(filtered);
        }

        // Dropdown interactions + accessibility
        function setOpen(open) {
          catBtn.setAttribute('aria-expanded', String(open));
          if (open) {
            catMenu.classList.remove('pointer-events-none');
            catMenu.style.maxHeight = '240px';
            catMenu.style.opacity = '1';
            catMenu.style.overflow = 'auto';
          } else {
            catMenu.classList.add('pointer-events-none');
            catMenu.style.maxHeight = '0px';
            catMenu.style.opacity = '0';
            catMenu.style.overflow = 'hidden';
          }
        }
        catBtn.addEventListener('click', () => {
          const open = catBtn.getAttribute('aria-expanded') === 'true';
          setOpen(!open);
        });
        document.addEventListener('click', (e) => {
          if (!catMenu.contains(e.target) && !catBtn.contains(e.target)) setOpen(false);
        });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
        catMenu.addEventListener('click', (e) => {
          const opt = e.target.closest('[role="option"]');
          if (!opt) return;
          const value = opt.getAttribute('data-value');
          const label = opt.textContent.trim();
          catBtn.textContent = label;
          // update selection state
          catMenu.querySelectorAll('[role="option"]').forEach(o => o.setAttribute('aria-selected','false'));
          opt.setAttribute('aria-selected','true');
          // reflect in native select and filter
          selectEl.value = value;
          setOpen(false);
          applyFilters();
        });

        // Try cached payload first for instant render
        try {
          const cachedRaw = localStorage.getItem(CACHE_KEY);
          if (cachedRaw) {
            const cached = JSON.parse(cachedRaw);
            if (cached?.projects && Array.isArray(cached.projects)) {
              // Optionally enforce TTL before rendering cache
              if (!cached.ts || (Date.now() - cached.ts) < CACHE_TTL_MS) {
                // randomize order each visit
                projects = shuffle(cached.projects);
                // collect categories from cached projects so dropdown populates
                collectCategoriesFromProjects(cached.projects);
                render(projects);
                // hide loading status
                loadingEl.classList.add('hidden');
                if (loadingEl._dotTimer) { clearInterval(loadingEl._dotTimer); loadingEl._dotTimer = null; }
                hasRenderedInitial = true;
              }
            }
          }
        } catch {}

        // Fetch fresh data and update UI/cache
        await fetchProjects();
        if (projects.length) {
          render(projects);
          loadingEl.classList.add('hidden');
          if (loadingEl._dotTimer) { clearInterval(loadingEl._dotTimer); loadingEl._dotTimer = null; }
        }
        
        searchEl.addEventListener('input', applyFilters);
        selectEl.addEventListener('change', applyFilters);
      });
    </script>
  </section>
  <div id="discover-footer" class="hidden">
    <FooterAlt />
  </div>
  <ScrollToTop threshold={800} />
</Layout>
